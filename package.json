{
    "name": "sphinx-unbloated-theme",
    "license": "GPL-3.0-only",
    "repository": "https://github.com/jorgemartinez/sphinx-unbloated-theme",
    "scripts": {
        "build:css": "postcss src/sphinx_unbloated_theme/theme/sphinx_unbloated_theme/static/css/style.css -o src/sphinx_unbloated_theme/theme/sphinx_unbloated_theme/static/css/style.css",
        "build": "npm run build:css",
        "test:visual:ref": "backstop reference --config tests/backstop/backstop.config.js",
        "test:visual": "backstop test --config tests/backstop/backstop.config.js",
        "test:playwright": "playwright test --config tests/playwright/playwright.config.js",
        "test:puppeteer": "jest --config tests/puppeteer/jest.config.js",
        "test": "npm run test:playwright && npm run test:puppeteer"
    },
    "devDependencies": {
        "@playwright/test": "^1.51.1",
        "autoprefixer": "^10.4.21",
        "backstopjs": "^6.3.25",
        "cssnano": "^7.1.3",
        "jest": "^29.7.0",
        "postcss": "^8.5.3",
        "postcss-cli": "^11.0.0",
        "postcss-custom-media": "^10.0.4",
        "postcss-nested": "^7.0.2",
        "puppeteer": "^24.4.0"
    }
}
